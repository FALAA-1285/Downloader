# Salin menjadi .env lalu sesuaikan. File .env tidak boleh masuk version control.

APP_ENV=development
# Dipakai oleh `uv run python -m app`.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Database ---------------------------------------------------------------
# Lokal (PostgreSQL Laragon):
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/media_downloader
# Docker Compose memakai nilai di bawah untuk membuat database dan menimpa DATABASE_URL.
POSTGRES_USER=media
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=media_downloader

# --- Antrean ----------------------------------------------------------------
# inline: unduhan diproses di proses API (Windows/dev, tanpa Redis)
# rq: unduhan diproses worker RQ (Docker Compose otomatis memakai rq)
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Batas & retensi --------------------------------------------------------
MAX_DOWNLOAD_SIZE_MB=200
MAX_SUBTITLE_SIZE_MB=5
MAX_STORAGE_MB=2048
DOWNLOAD_TIMEOUT_SECONDS=120
FILE_RETENTION_HOURS=24
# Riwayat job selesai/gagal/dibatalkan dihapus setelah sekian hari (0 = simpan selamanya).
HISTORY_RETENTION_DAYS=30
MAX_ZIP_SIZE_MB=4096
# Job antre yang tidak diambil worker selama ini ditandai gagal.
STALE_PENDING_SECONDS=3600
ANALYZE_TIMEOUT_SECONDS=25

# Relatif terhadap folder backend/ (bukan direktori kerja).
STORAGE_PATH=../storage

# --- Keamanan ---------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Klien yang boleh memakai API. Default hanya localhost; Docker Compose menambahkan jaringan bridge.
# Jangan buka ke LAN tanpa API_TOKEN (PRD §15.3).
ALLOWED_CLIENT_NETWORKS=127.0.0.0/8,::1/128
# Opsional. Jika diisi, semua request API wajib membawa `Authorization: Bearer <token>`.
# Isi NEXT_PUBLIC_API_TOKEN di frontend dengan nilai yang sama.
API_TOKEN=
MAX_REQUEST_BODY_KB=64
# Port tujuan yang boleh dihubungi saat menganalisis/mengunduh.
ALLOWED_PORTS=80,443,8080,8443
RATE_LIMIT_ANALYZE_PER_MINUTE=20
RATE_LIMIT_DOWNLOADS_PER_MINUTE=30
# Contoh: DISABLED_ADAPTERS=youtube,tiktok (berlaku untuk semua adapter, termasuk platform)
DISABLED_ADAPTERS=

# --- Render dinamis (Playwright) ---------------------------------------------
ENABLE_DYNAMIC_RENDERING=true
# Sandbox Chromium. Docker Compose mematikannya karena container tanpa user namespace tidak
# mendukungnya; lalu lintas Chromium tetap dibatasi proxy penjaga SSRF.
CHROMIUM_SANDBOX=true
# Batas thread yt-dlp yang menganalisis bersamaan.
YTDLP_EXTRACT_CONCURRENCY=2
